{
  "version": 1,
  "endianness": "little",
  "session": "synthetic_test",
  "desc_bits": 4,
  "geo_grid": {
    "dtype": "uint8",
    "max": 90,
    "qparams": [0.0, 0.0, 100.0],
    "meaning": "grid_x, grid_y in [0..max]; computed by shared span R"
  },
  "ivf": {
    "centroids_ref": "use map.json/ivf_centroids.bin",
    "postings_ref": "use map.json/ivf_postings_*.bin",
    "map_json_ref": "../map/map.json"
  },
  "bins": {
    "query_desc_q4": {
      "file": "query_desc_q4.bin",
      "dtype": "uint8",
      "shape": [5, 64],
      "c_order": true,
      "bytes": 320
    },
    "query_step_pose_grid": {
      "file": "query_step_pose_grid.bin",
      "dtype": "uint8",
      "shape": [1, 2],
      "c_order": true,
      "bytes": 2
    },
    "query_step_offsets": {
      "file": "query_step_offsets.bin",
      "dtype": "uint32",
      "shape": [2],
      "c_order": true,
      "bytes": 8
    },
    "query_step_counts": {
      "file": "query_step_counts.bin",
      "dtype": "uint16",
      "shape": [1],
      "c_order": true,
      "bytes": 2
    },
    "query_step_relodo_i": {
      "file": "query_step_relodo_i.bin",
      "dtype": "int32",
      "shape": [1],
      "c_order": true,
      "bytes": 4
    },
    "query_step_t_now": {
      "file": "query_step_t_now.bin",
      "dtype": "float64",
      "shape": [1],
      "c_order": true,
      "bytes": 8
    }
  }
}
